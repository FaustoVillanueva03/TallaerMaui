<?xml version="1.0" encoding="utf-8" ?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    xmlns:models="clr-namespace:MAUINavegacion.Models"
    x:Class="MAUINavegacion.PerfilPage"
    x:DataType="models:Perfil"
    Title="Perfiles"
    BackgroundColor="{StaticResource ColorFondo}">

    <Grid
        RowDefinitions="Auto,*"
        Padding="24"
        RowSpacing="18">

        <!-- ENCABEZADO -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="15">

            <Button
                Grid.Column="0"
                Text="← Volver"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                CornerRadius="12"
                Clicked="OnVolverClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="3"
                VerticalOptions="Center">

                <Label
                    Text="PERFILES"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource ColorTextoPrincipal}" />

                <Label
                    Text="Administrá los perfiles de tu cuenta"
                    FontSize="14"
                    TextColor="{StaticResource ColorTextoSecundario}" />

            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="+ Nuevo perfil"
                Padding="18,10"
                BackgroundColor="{StaticResource ColorPrimario}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontAttributes="Bold"
                CornerRadius="12"
                Clicked="OnNuevoPerfilClicked" />

        </Grid>

        <!-- CONTENIDO -->

        <Grid Grid.Row="1">

            <!-- LISTA DE PERFILES -->

            <CollectionView
                x:Name="ListaPerfiles"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:Perfil">

                        <Border
                            Margin="0,0,0,14"
                            Padding="18"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficie}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="90,*,Auto"
                                ColumnSpacing="18">

                                <!-- FOTO -->

                                <Border
                                    Grid.Column="0"
                                    HeightRequest="82"
                                    WidthRequest="82"
                                    Padding="0"
                                    Stroke="{StaticResource ColorPrimario}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="41" />
                                    </Border.StrokeShape>

                                    <Grid>

                                        <Image
                                            Source="{Binding RutaFoto}"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="👤"
                                            FontSize="38"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            HorizontalTextAlignment="Center" />

                                    </Grid>

                                </Border>

                                <!-- DATOS -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource ColorTextoPrincipal}" />

                                    <Label
                                        Text="{Binding Email}"
                                        FontSize="14"
                                        TextColor="{StaticResource ColorTextoSecundario}" />

                                    <Label
                                        Text="{Binding Telefono}"
                                        FontSize="14"
                                        TextColor="{StaticResource ColorTextoSecundario}" />

                                    <HorizontalStackLayout
                                        Spacing="7"
                                        Margin="0,4,0,0">

                                        <Border
                                            Padding="9,4"
                                            Stroke="{StaticResource ColorPrimario}"
                                            StrokeThickness="1"
                                            BackgroundColor="{StaticResource ColorSuperficieClara}">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="Preferencias"
                                                FontSize="12"
                                                TextColor="{StaticResource ColorPrimario}" />

                                        </Border>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <!-- BOTONES -->

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="9"
                                    VerticalOptions="Center">

                                    <Button
                                        Text="Usar perfil"
                                        Padding="15,9"
                                        BackgroundColor="{StaticResource ColorPrimario}"
                                        TextColor="{StaticResource ColorTextoPrincipal}"
                                        CornerRadius="10"
                                        Clicked="OnUsarPerfilClicked" />

                                    <Button
                                        Text="Editar"
                                        Padding="15,9"
                                        BackgroundColor="{StaticResource ColorSuperficieClara}"
                                        TextColor="{StaticResource ColorTextoPrincipal}"
                                        BorderColor="{StaticResource ColorPrimario}"
                                        BorderWidth="1"
                                        CornerRadius="10"
                                        Clicked="OnEditarPerfilClicked" />

                                    <Button
                                        Text="Eliminar"
                                        Padding="15,9"
                                        BackgroundColor="{StaticResource ColorSuperficieClara}"
                                        TextColor="{StaticResource ColorError}"
                                        BorderColor="{StaticResource ColorError}"
                                        BorderWidth="1"
                                        CornerRadius="10"
                                        Clicked="OnEliminarPerfilClicked" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- SIN PERFILES -->

            <VerticalStackLayout
                x:Name="SinPerfilesLayout"
                IsVisible="False"
                Spacing="15"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Label
                    Text="👤"
                    FontSize="70"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Todavía no hay perfiles"
                    FontSize="24"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorTextoPrincipal}" />

                <Label
                    Text="Creá un perfil para elegir qué secciones puede ver."
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorTextoSecundario}" />

                <Button
                    Text="+ Crear perfil"
                    Margin="0,10,0,0"
                    Padding="24,12"
                    BackgroundColor="{StaticResource ColorPrimario}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    CornerRadius="14"
                    Clicked="OnNuevoPerfilClicked" />

            </VerticalStackLayout>

            <!-- FORMULARIO -->

            <Grid
                x:Name="FormularioFondo"
                IsVisible="False"
                BackgroundColor="#AA000000">

                <Border
                    WidthRequest="650"
                    MaximumHeightRequest="780"
                    Padding="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="{StaticResource ColorPrimario}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource ColorSuperficie}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <ScrollView>

                        <VerticalStackLayout Spacing="16">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="15">

                                <Label
                                    x:Name="TituloFormularioLabel"
                                    Grid.Column="0"
                                    Text="Nuevo perfil"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Button
                                    Grid.Column="1"
                                    Text="✕"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0"
                                    BackgroundColor="{StaticResource ColorSuperficieClara}"
                                    TextColor="{StaticResource ColorTextoPrincipal}"
                                    CornerRadius="21"
                                    Clicked="OnCerrarFormularioClicked" />

                            </Grid>

                            <!-- FOTO -->

                            <HorizontalStackLayout
                                Spacing="15"
                                VerticalOptions="Center">

                                <Border
                                    HeightRequest="90"
                                    WidthRequest="90"
                                    Padding="0"
                                    Stroke="{StaticResource ColorPrimario}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45" />
                                    </Border.StrokeShape>

                                    <Grid>

                                        <Image
                                            x:Name="FotoPerfilImage"
                                            Aspect="AspectFill" />

                                        <Label
                                            x:Name="FotoVaciaLabel"
                                            Text="👤"
                                            FontSize="40"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                                <Button
                                    Text="Elegir foto"
                                    BackgroundColor="{StaticResource ColorSuperficieClara}"
                                    TextColor="{StaticResource ColorTextoPrincipal}"
                                    BorderColor="{StaticResource ColorPrimario}"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    Clicked="OnElegirFotoClicked" />

                            </HorizontalStackLayout>

                            <!-- DATOS -->

                            <Entry
                                x:Name="NombreEntry"
                                Placeholder="Nombre del perfil"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                                BackgroundColor="{StaticResource ColorSuperficieClara}" />

                            <Label
                                x:Name="NombreErrorLabel"
                                IsVisible="False"
                                FontSize="12"
                                TextColor="{StaticResource ColorError}" />

                            <Entry
                                x:Name="EmailEntry"
                                Placeholder="Correo electrónico"
                                Keyboard="Email"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                                BackgroundColor="{StaticResource ColorSuperficieClara}" />

                            <Entry
                                x:Name="TelefonoEntry"
                                Placeholder="Teléfono"
                                Keyboard="Telephone"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                                BackgroundColor="{StaticResource ColorSuperficieClara}" />

                            <Entry
                                x:Name="DireccionEntry"
                                Placeholder="Dirección"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                                BackgroundColor="{StaticResource ColorSuperficieClara}" />

                            <!-- PREFERENCIAS -->

                            <Label
                                Text="Secciones visibles"
                                Margin="0,8,0,0"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource ColorTextoPrincipal}" />

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="12">

                                <Label
                                    Grid.Row="0"
                                    Text="Películas"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Switch
                                    x:Name="MostrarPeliculasSwitch"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    OnColor="{StaticResource ColorPrimario}" />

                                <Label
                                    Grid.Row="1"
                                    Text="Series"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Switch
                                    x:Name="MostrarSeriesSwitch"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    OnColor="{StaticResource ColorPrimario}" />

                                <Label
                                    Grid.Row="2"
                                    Text="Clima"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Switch
                                    x:Name="MostrarClimaSwitch"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    OnColor="{StaticResource ColorPrimario}" />

                                <Label
                                    Grid.Row="3"
                                    Text="Cotizaciones"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Switch
                                    x:Name="MostrarCotizacionesSwitch"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    OnColor="{StaticResource ColorPrimario}" />

                                <Label
                                    Grid.Row="4"
                                    Text="Mapa"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Switch
                                    x:Name="MostrarMapaSwitch"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    OnColor="{StaticResource ColorPrimario}" />

                            </Grid>

                            <Button
                                x:Name="GuardarPerfilButton"
                                Text="Guardar perfil"
                                HeightRequest="52"
                                Margin="0,10,0,0"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource ColorPrimario}"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                CornerRadius="14"
                                Clicked="OnGuardarPerfilClicked" />

                        </VerticalStackLayout>

                    </ScrollView>

                </Border>

            </Grid>

            <!-- CARGANDO -->

            <Border
                x:Name="CargandoLayout"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="24"
                Stroke="{StaticResource ColorPrimario}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <ActivityIndicator
                        x:Name="CargandoIndicator"
                        IsRunning="False"
                        Color="{StaticResource ColorPrimario}" />

                    <Label
                        Text="Cargando perfiles..."
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</local:BasePage>
<?xml version="1.0" encoding="utf-8" ?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    xmlns:models="clr-namespace:MAUINavegacion.Models"
    x:Class="MAUINavegacion.SeriesPage"
    Title="Series"
    BackgroundColor="{StaticResource ColorFondo}">

    <ContentPage.Resources>

        <Style
            x:Key="TarjetaContenidoStyle"
            TargetType="Border">

            <Setter
                Property="BackgroundColor"
                Value="{StaticResource ColorSuperficie}" />

            <Setter
                Property="Stroke"
                Value="{StaticResource ColorBorde}" />

            <Setter
                Property="StrokeThickness"
                Value="1" />

            <Setter
                Property="Scale"
                Value="1" />

            <Setter
                Property="Opacity"
                Value="1" />

            <Setter Property="VisualStateManager.VisualStateGroups">

                <VisualStateGroupList>

                    <VisualStateGroup x:Name="CommonStates">

                        <VisualState x:Name="Normal">

                            <VisualState.Setters>

                                <Setter
                                    Property="Scale"
                                    Value="1" />

                                <Setter
                                    Property="Opacity"
                                    Value="1" />

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource ColorSuperficie}" />

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource ColorBorde}" />

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState x:Name="PointerOver">

                            <VisualState.Setters>

                                <Setter
                                    Property="Scale"
                                    Value="1" />

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource ColorSuperficieClara}" />

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource ColorPrimario}" />

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState x:Name="Pressed">

                            <VisualState.Setters>

                                <Setter
                                    Property="Scale"
                                    Value="0.98" />

                                <Setter
                                    Property="Opacity"
                                    Value="0.85" />

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource ColorPrimario}" />

                            </VisualState.Setters>

                        </VisualState>

                    </VisualStateGroup>

                </VisualStateGroupList>

            </Setter>

        </Style>

    </ContentPage.Resources>


    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">


        <!-- BOTÓN VOLVER -->

        <Button
            Grid.Row="0"
            Text="← Volver"
            HorizontalOptions="Start"
            BackgroundColor="{StaticResource ColorSuperficie}"
            TextColor="{StaticResource ColorTextoPrincipal}"
            BorderColor="{StaticResource ColorPrimario}"
            BorderWidth="1"
            CornerRadius="12"
            Clicked="OnVolverClicked" />


        <!-- ENCABEZADO -->

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="3">

            <Label
                Text="REDFLIX"
                TextColor="{StaticResource ColorPrimario}"
                FontSize="14"
                FontAttributes="Bold"
                CharacterSpacing="3" />

            <Label
                Text="Series"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                Text="Buscá una serie o explorá las populares"
                TextColor="{StaticResource ColorTextoSecundario}"
                FontSize="14" />

        </VerticalStackLayout>


        <!-- BUSCADOR -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <Border
                Grid.Column="0"
                BackgroundColor="{StaticResource ColorSuperficie}"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                Padding="14,0"
                HeightRequest="50">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Entry
                    x:Name="BusquedaEntry"
                    Placeholder="Buscar serie..."
                    PlaceholderColor="{StaticResource ColorTextoSecundario}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    FontSize="15"
                    ReturnType="Search"
                    Completed="OnBuscarCompleted" />

            </Border>


            <Button
                Grid.Column="1"
                Text="🔍"
                WidthRequest="55"
                HeightRequest="50"
                BackgroundColor="{StaticResource ColorPrimario}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="20"
                CornerRadius="14"
                Clicked="OnBuscarClicked" />

        </Grid>


        <!-- CONTENIDO -->

        <Grid
            Grid.Row="3">

            <!-- INDICADOR DE CARGA -->

            <ActivityIndicator
                x:Name="Cargando"
                IsVisible="False"
                IsRunning="False"
                Color="{StaticResource ColorPrimario}"
                WidthRequest="50"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Center" />


            <!-- LISTA DE SERIES -->

            <CollectionView
                x:Name="ListaSeries"
                SelectionMode="Single"
                SelectionChanged="OnSerieSeleccionada"
                EmptyView="No se encontraron series">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="14" />

                </CollectionView.ItemsLayout>


                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Serie">

                        <Border
                            Style="{StaticResource TarjetaContenidoStyle}"
                            Padding="12"
                            Margin="8,4">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="18" />
                            </Border.StrokeShape>


                            <Grid
                                ColumnDefinitions="110,*"
                                ColumnSpacing="16">


                                <!-- IMAGEN -->

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="110"
                                    HeightRequest="165"
                                    StrokeThickness="0"
                                    Padding="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Image
                                        Source="{Binding ImagenCompleta}"
                                        Aspect="AspectFill" />

                                </Border>


                                <!-- INFORMACIÓN -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="10">

                                    <Label
                                        Text="{Binding Nombre}"
                                        TextColor="{StaticResource ColorTextoPrincipal}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />


                                    <HorizontalStackLayout
                                        Spacing="8">

                                        <!-- PUNTUACIÓN -->

                                        <Border
                                            BackgroundColor="{StaticResource ColorPrimarioOscuro}"
                                            StrokeThickness="0"
                                            Padding="10,5">

                                            <Border.StrokeShape>
                                                <RoundRectangle
                                                    CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="{Binding PuntuacionTexto}"
                                                TextColor="{StaticResource ColorTextoPrincipal}"
                                                FontAttributes="Bold"
                                                FontSize="13" />

                                        </Border>


                                        <!-- FECHA -->

                                        <Border
                                            BackgroundColor="{StaticResource ColorSuperficieClara}"
                                            StrokeThickness="0"
                                            Padding="10,5">

                                            <Border.StrokeShape>
                                                <RoundRectangle
                                                    CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="{Binding FechaTexto}"
                                                TextColor="{StaticResource ColorTextoSecundario}"
                                                FontSize="13" />

                                        </Border>

                                    </HorizontalStackLayout>


                                    <Label
                                        Text="{Binding DescripcionCompleta}"
                                        TextColor="{StaticResource ColorTextoSecundario}"
                                        FontSize="14"
                                        MaxLines="3"
                                        LineBreakMode="TailTruncation" />


                                    <Label
                                        Text="Ver detalles  →"
                                        TextColor="{StaticResource ColorPrimario}"
                                        FontSize="14"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</local:BasePage>
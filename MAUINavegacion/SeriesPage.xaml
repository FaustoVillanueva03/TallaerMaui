<?xml version="1.0" encoding="utf-8" ?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    xmlns:models="clr-namespace:MAUINavegacion.Models"
    x:Class="MAUINavegacion.SeriesPage"
    Title="Series"
    BackgroundColor="{StaticResource ColorFondo}">

    <local:BasePage.Resources>

        <Style
            x:Key="CategoriaButtonStyle"
            TargetType="Button">

            <Setter
                Property="BackgroundColor"
                Value="{StaticResource ColorSuperficie}" />

            <Setter
                Property="TextColor"
                Value="{StaticResource ColorPrimario}" />

            <Setter
                Property="BorderColor"
                Value="{StaticResource ColorBorde}" />

            <Setter
                Property="BorderWidth"
                Value="1" />

            <Setter
                Property="CornerRadius"
                Value="18" />

            <Setter
                Property="Padding"
                Value="18,8" />

        </Style>

    </local:BasePage.Resources>

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="15">

        <!-- VOLVER -->

        <Button
            Grid.Row="0"
            Text="← Volver"
            HorizontalOptions="Start"
            BackgroundColor="{StaticResource ColorSuperficie}"
            TextColor="{StaticResource ColorTextoPrincipal}"
            BorderColor="{StaticResource ColorPrimario}"
            BorderWidth="1"
            CornerRadius="12"
            Clicked="OnVolverClicked" />

        <!-- ENCABEZADO -->

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="3">

            <Label
                Text="REDFLIX"
                TextColor="{StaticResource ColorPrimario}"
                FontSize="14"
                FontAttributes="Bold"
                CharacterSpacing="3" />

            <Label
                Text="Series"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                Text="Buscá una serie o explorá por categoría"
                TextColor="{StaticResource ColorTextoSecundario}"
                FontSize="14" />

            <Label
                x:Name="PerfilMenorLabel"
                Text="👶 Perfil para menores"
                IsVisible="False"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{StaticResource ColorPrimario}" />

        </VerticalStackLayout>

        <!-- BUSCADOR -->

        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource ColorSuperficie}"
            Stroke="{StaticResource ColorBorde}"
            StrokeThickness="1"
            Padding="14,0"
            HeightRequest="52">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">

                <Label
                    Grid.Column="0"
                    Text="🔍"
                    FontSize="18"
                    VerticalOptions="Center"
                    TextColor="{StaticResource ColorPrimario}" />

                <Entry
                    x:Name="BusquedaEntry"
                    Grid.Column="1"
                    Placeholder="Buscar serie..."
                    PlaceholderColor="{StaticResource ColorTextoSecundario}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    ReturnType="Search"
                    Completed="OnBuscarCompleted" />

            </Grid>

        </Border>

        <!-- CATEGORÍAS -->

        <VerticalStackLayout
            Grid.Row="3"
            Spacing="8">

            <Label
                Text="Categorías"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{StaticResource ColorTextoPrincipal}" />

            <ScrollView
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout Spacing="8">

                    <Button
                        x:Name="TodasButton"
                        Text="Todas"
                        CommandParameter="0"
                        Clicked="OnCategoriaClicked"
                        BackgroundColor="{StaticResource ColorPrimario}"
                        TextColor="{StaticResource ColorTextoPrincipal}"
                        BorderColor="{StaticResource ColorPrimario}"
                        BorderWidth="1"
                        CornerRadius="18"
                        Padding="18,8" />

                    <Button
                        x:Name="AccionAventuraButton"
                        Text="Acción y aventura"
                        CommandParameter="10759"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="AnimacionButton"
                        Text="Animación"
                        CommandParameter="16"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="ComediaButton"
                        Text="Comedia"
                        CommandParameter="35"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="CrimenButton"
                        Text="Crimen"
                        CommandParameter="80"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="DramaButton"
                        Text="Drama"
                        CommandParameter="18"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="FamiliaButton"
                        Text="Familia"
                        CommandParameter="10751"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="MisterioButton"
                        Text="Misterio"
                        CommandParameter="9648"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="RealityButton"
                        Text="Reality"
                        CommandParameter="10764"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="CienciaFiccionButton"
                        Text="Ciencia ficción"
                        CommandParameter="10765"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="GuerraPoliticaButton"
                        Text="Guerra y política"
                        CommandParameter="10768"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                    <Button
                        x:Name="WesternButton"
                        Text="Western"
                        CommandParameter="37"
                        Clicked="OnCategoriaClicked"
                        Style="{StaticResource CategoriaButtonStyle}" />

                </HorizontalStackLayout>

            </ScrollView>

        </VerticalStackLayout>

        <!-- LISTADO -->

        <Grid Grid.Row="4">

            <ActivityIndicator
                x:Name="Cargando"
                IsVisible="False"
                IsRunning="False"
                Color="{StaticResource ColorPrimario}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <CollectionView
                x:Name="ListaSeries"
                SelectionMode="Single"
                SelectionChanged="OnSerieSeleccionada"
                EmptyView="No se encontraron series">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="14" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:Serie">

                        <Border
                            BackgroundColor="{StaticResource ColorSuperficie}"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="110,*"
                                ColumnSpacing="16">

                                <Image
                                    Grid.Column="0"
                                    Source="{Binding ImagenCompleta}"
                                    WidthRequest="110"
                                    HeightRequest="165"
                                    Aspect="AspectFill" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="10">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource ColorTextoPrincipal}"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="8">

                                        <Border
                                            BackgroundColor="{StaticResource ColorPrimarioOscuro}"
                                            StrokeThickness="0"
                                            Padding="10,5">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="{Binding PuntuacionTexto}"
                                                TextColor="{StaticResource ColorTextoPrincipal}"
                                                FontAttributes="Bold"
                                                FontSize="13" />

                                        </Border>

                                        <Border
                                            BackgroundColor="{StaticResource ColorSuperficieClara}"
                                            StrokeThickness="0"
                                            Padding="10,5">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="{Binding FechaTexto}"
                                                TextColor="{StaticResource ColorTextoSecundario}"
                                                FontSize="13" />

                                        </Border>

                                    </HorizontalStackLayout>

                                    <Label
                                        Text="{Binding DescripcionCompleta}"
                                        TextColor="{StaticResource ColorTextoSecundario}"
                                        FontSize="14"
                                        MaxLines="3"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="Ver detalles →"
                                        TextColor="{StaticResource ColorPrimario}"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</local:BasePage>
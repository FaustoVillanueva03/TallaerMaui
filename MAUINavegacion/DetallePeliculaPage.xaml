<?xml version="1.0" encoding="utf-8"?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    x:Class="MAUINavegacion.DetallePeliculaPage"
    Title="Detalle"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <Button
                Text="← Volver"
                HorizontalOptions="Start"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                CornerRadius="12"
                Margin="20,15,0,10"
                Clicked="OnVolverClicked" />

            <Grid HeightRequest="420">

                <Image
                    Source="{Binding ImagenCompleta}"
                    Aspect="AspectFill"
                    Opacity="0.25" />

                <BoxView
                    BackgroundColor="{StaticResource ColorFondo}"
                    Opacity="0.35" />

                <Image
                    Source="{Binding ImagenCompleta}"
                    Aspect="AspectFit"
                    Margin="35,20" />

            </Grid>

            <VerticalStackLayout
                Padding="24,22,24,40"
                Spacing="18">

                <Label
                    Text="{Binding Titulo}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    FontSize="32"
                    FontAttributes="Bold" />

                <HorizontalStackLayout Spacing="10">

                    <Border
                        BackgroundColor="{StaticResource ColorPrimarioOscuro}"
                        StrokeThickness="0"
                        Padding="12,7">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding PuntuacionTexto}"
                            TextColor="{StaticResource ColorTextoPrincipal}"
                            FontSize="15"
                            FontAttributes="Bold" />

                    </Border>

                    <Border
                        BackgroundColor="{StaticResource ColorSuperficieClara}"
                        StrokeThickness="0"
                        Padding="12,7">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding FechaTexto}"
                            TextColor="{StaticResource ColorTextoSecundario}"
                            FontSize="15" />

                    </Border>

                </HorizontalStackLayout>

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}" />

                <Label
                    Text="Seleccioná una opción"
                    TextColor="{StaticResource ColorPrimario}"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Button
                        x:Name="AlquilarButton"
                        Grid.Column="0"
                        Text="Alquilar"
                        CornerRadius="14"
                        BorderWidth="1"
                        BorderColor="{StaticResource ColorPrimario}"
                        BackgroundColor="{StaticResource ColorPrimario}"
                        TextColor="{StaticResource ColorTextoPrincipal}"
                        Clicked="OnAlquilarClicked" />

                    <Button
                        x:Name="ComprarButton"
                        Grid.Column="1"
                        Text="Comprar"
                        CornerRadius="14"
                        BorderWidth="1"
                        BorderColor="{StaticResource ColorPrimario}"
                        BackgroundColor="{StaticResource ColorSuperficie}"
                        TextColor="{StaticResource ColorPrimario}"
                        Clicked="OnComprarClicked" />

                </Grid>

                <ActivityIndicator
                    x:Name="CargandoPrecio"
                    IsVisible="False"
                    IsRunning="False"
                    Color="{StaticResource ColorPrimario}"
                    HorizontalOptions="Center" />

                <Border
                    x:Name="SeccionPrecio"
                    IsVisible="False"
                    Padding="20"
                    Stroke="{StaticResource ColorPrimario}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource ColorSuperficie}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <Label
                            x:Name="ModalidadSeleccionadaLabel"
                            Text="Precio de alquiler"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource ColorTextoPrincipal}" />

                        <Label
                            x:Name="PrecioPrincipalLabel"
                            FontSize="30"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource ColorPrimario}" />

                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            ColumnSpacing="8">

                            <Button
                                x:Name="UYUButton"
                                Grid.Column="0"
                                Text="UYU"
                                Padding="8"
                                CornerRadius="12"
                                BorderWidth="1"
                                BorderColor="{StaticResource ColorPrimario}"
                                BackgroundColor="{StaticResource ColorPrimario}"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                Clicked="OnUYUClicked" />

                            <Button
                                x:Name="USDButton"
                                Grid.Column="1"
                                Text="USD"
                                Padding="8"
                                CornerRadius="12"
                                BorderWidth="1"
                                BorderColor="{StaticResource ColorPrimario}"
                                BackgroundColor="{StaticResource ColorSuperficie}"
                                TextColor="{StaticResource ColorPrimario}"
                                Clicked="OnUSDClicked" />

                            <Button
                                x:Name="EURButton"
                                Grid.Column="2"
                                Text="EUR"
                                Padding="8"
                                CornerRadius="12"
                                BorderWidth="1"
                                BorderColor="{StaticResource ColorPrimario}"
                                BackgroundColor="{StaticResource ColorSuperficie}"
                                TextColor="{StaticResource ColorPrimario}"
                                Clicked="OnEURClicked" />

                            <Button
                                x:Name="BRLButton"
                                Grid.Column="3"
                                Text="BRL"
                                Padding="8"
                                CornerRadius="12"
                                BorderWidth="1"
                                BorderColor="{StaticResource ColorPrimario}"
                                BackgroundColor="{StaticResource ColorSuperficie}"
                                TextColor="{StaticResource ColorPrimario}"
                                Clicked="OnBRLClicked" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <Button
                    x:Name="AgregarCarritoButton"
                    Text="🛒 Agregar al carrito"
                    HeightRequest="52"
                    CornerRadius="14"
                    BackgroundColor="{StaticResource ColorPrimario}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    FontAttributes="Bold"
                    Clicked="OnAgregarCarritoClicked" />

                <Label
                    x:Name="MensajeCarritoLabel"
                    IsVisible="False"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorExito}"
                    FontSize="14" />

                <Label
                    x:Name="MensajeErrorPrecio"
                    IsVisible="False"
                    TextColor="{StaticResource ColorError}"
                    FontSize="14" />

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}" />

                <Label
                    Text="Sinopsis"
                    TextColor="{StaticResource ColorPrimario}"
                    FontSize="19"
                    FontAttributes="Bold" />

                <Label
                    Text="{Binding DescripcionCompleta}"
                    TextColor="{StaticResource ColorTextoSecundario}"
                    FontSize="16"
                    LineHeight="1.4" />

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}"
                    Margin="0,5" />

                <!-- TRÁILER -->

                <VerticalStackLayout
                    x:Name="SeccionTrailer"
                    IsVisible="False"
                    Spacing="12">

                    <Label
                        Text="Tráiler"
                        TextColor="{StaticResource ColorPrimario}"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Border
                        BackgroundColor="Black"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <local:YoutubeWebView
                            x:Name="TrailerWebView"
                            HeightRequest="300"
                            HorizontalOptions="Fill" />

                    </Border>

                </VerticalStackLayout>

                <Label
                    x:Name="MensajeSinTrailer"
                    Text="Cargando tráiler..."
                    TextColor="{StaticResource ColorTextoSecundario}"
                    FontSize="14"
                    IsVisible="True" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</local:BasePage>
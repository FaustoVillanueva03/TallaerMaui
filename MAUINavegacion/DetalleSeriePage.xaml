<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAUINavegacion.DetalleSeriePage"
    Title="Detalle de serie"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- BOTÓN VOLVER -->

            <Button
                Text="← Volver"
                HorizontalOptions="Start"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                CornerRadius="12"
                Margin="20,15,0,10"
                Clicked="OnVolverClicked" />

            <!-- PORTADA -->

            <Grid HeightRequest="420">

                <!-- Fondo ampliado -->

                <Image
                    Source="{Binding ImagenCompleta}"
                    Aspect="AspectFill"
                    Opacity="0.20" />

                <BoxView
                    BackgroundColor="{StaticResource ColorFondo}"
                    Opacity="0.45" />

                <!-- Portada completa -->

                <Image
                    Source="{Binding ImagenCompleta}"
                    Aspect="AspectFit"
                    Margin="35,20" />

            </Grid>

            <!-- INFORMACIÓN -->

            <VerticalStackLayout
                Padding="24,22,24,40"
                Spacing="18">

                <Label
                    Text="{Binding Nombre}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    FontSize="32"
                    FontAttributes="Bold"
                    LineBreakMode="WordWrap" />

                <HorizontalStackLayout Spacing="10">

                    <Border
                        BackgroundColor="{StaticResource ColorPrimarioOscuro}"
                        StrokeThickness="0"
                        Padding="12,7">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding PuntuacionTexto}"
                            TextColor="{StaticResource ColorTextoPrincipal}"
                            FontSize="15"
                            FontAttributes="Bold" />

                    </Border>

                    <Border
                        BackgroundColor="{StaticResource ColorSuperficieClara}"
                        StrokeThickness="0"
                        Padding="12,7">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding FechaTexto}"
                            TextColor="{StaticResource ColorTextoSecundario}"
                            FontSize="15" />

                    </Border>

                </HorizontalStackLayout>

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}" />

                <Label
                    Text="Descripción"
                    TextColor="{StaticResource ColorPrimario}"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Label
                    Text="{Binding DescripcionCompleta}"
                    TextColor="{StaticResource ColorTextoSecundario}"
                    FontSize="16"
                    LineHeight="1.4" />

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}"
                    Margin="0,5" />

                <!-- TRÁILER -->

                <VerticalStackLayout
                    x:Name="SeccionTrailer"
                    Spacing="12"
                    IsVisible="False">

                    <Label
                        Text="Tráiler"
                        TextColor="{StaticResource ColorPrimario}"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Border
                        BackgroundColor="Black"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <WebView
                            x:Name="TrailerWebView"
                            HeightRequest="230" />

                    </Border>

                </VerticalStackLayout>

                <Label
                    x:Name="MensajeSinTrailer"
                    Text="Cargando tráiler..."
                    TextColor="{StaticResource ColorTextoSecundario}"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    IsVisible="True" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAUINavegacion.LoginPage"
    Title="Iniciar sesión"
    BackgroundColor="{StaticResource ColorFondo}"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="35"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="REDFLIX"
                TextColor="{StaticResource ColorPrimario}"
                FontSize="22"
                FontAttributes="Bold"
                CharacterSpacing="5"
                HorizontalOptions="Center" />

            <Label
                Text="Bienvenido"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="34"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Ingresá con tu cuenta o utilizá la huella digital"
                TextColor="{StaticResource ColorTextoSecundario}"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,15" />

            <Border
                BackgroundColor="{StaticResource ColorSuperficie}"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Entry
                    x:Name="UsuarioEntry"
                    Placeholder="Usuario"
                    PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    BackgroundColor="Transparent" />

            </Border>

            <Border
                BackgroundColor="{StaticResource ColorSuperficie}"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Entry
                    x:Name="ContrasenaEntry"
                    Placeholder="Contraseña"
                    PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    IsPassword="True"
                    BackgroundColor="Transparent" />

            </Border>

            <Button
                Text="Iniciar sesión"
                HeightRequest="55"
                BackgroundColor="{StaticResource ColorPrimario}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="17"
                FontAttributes="Bold"
                CornerRadius="15"
                Clicked="OnIniciarSesionClicked" />

            <Button
                Text="Crear una cuenta"
                BackgroundColor="Transparent"
                TextColor="{StaticResource ColorPrimario}"
                FontAttributes="Bold"
                Clicked="OnCrearCuentaClicked" />

            <Grid
                ColumnDefinitions="*,Auto,*"
                ColumnSpacing="12"
                Margin="0,10">

                <BoxView
                    Grid.Column="0"
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="1"
                    Text="o"
                    TextColor="{StaticResource ColorTextoDeshabilitado}" />

                <BoxView
                    Grid.Column="2"
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}"
                    VerticalOptions="Center" />

            </Grid>

            <Button
                Text="🔐 Ingresar con huella"
                HeightRequest="55"
                BackgroundColor="{StaticResource ColorSuperficie}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="17"
                CornerRadius="15"
                Clicked="OnHuellaClicked" />

            <Label
                x:Name="MensajeLabel"
                TextColor="{StaticResource ColorError}"
                FontSize="14"
                HorizontalTextAlignment="Center"
                IsVisible="False" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
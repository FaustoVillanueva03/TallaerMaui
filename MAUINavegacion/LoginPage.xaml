<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAUINavegacion.LoginPage"
    Title="Iniciar sesión"
    BackgroundColor="{StaticResource ColorFondo}"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="35"
            Spacing="14"
            VerticalOptions="Center">

            <Label
                Text="REDFLIX"
                TextColor="{StaticResource ColorPrimario}"
                FontSize="22"
                FontAttributes="Bold"
                CharacterSpacing="5"
                HorizontalOptions="Center" />

            <Label
                Text="Bienvenido"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="34"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Ingresá con tu cuenta o utilizá la huella digital"
                TextColor="{StaticResource ColorTextoSecundario}"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,15" />

            <!-- USUARIO -->

            <Border
                BackgroundColor="{StaticResource ColorSuperficie}"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Entry
                    x:Name="UsuarioEntry"
                    Placeholder="Usuario"
                    PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    BackgroundColor="Transparent" />

            </Border>

            <Label
                x:Name="UsuarioErrorLabel"
                TextColor="{StaticResource ColorError}"
                FontSize="13"
                FontAttributes="Bold"
                Margin="5,-8,0,0"
                IsVisible="False" />

            <!-- CONTRASEÑA -->

            <Border
                BackgroundColor="{StaticResource ColorSuperficie}"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Entry
                    x:Name="ContrasenaEntry"
                    Placeholder="Contraseña"
                    PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    IsPassword="True"
                    BackgroundColor="Transparent" />

            </Border>

            <Label
                x:Name="ContrasenaErrorLabel"
                TextColor="{StaticResource ColorError}"
                FontSize="13"
                FontAttributes="Bold"
                Margin="5,-8,0,0"
                IsVisible="False" />

            <!-- INICIAR SESIÓN -->

            <Button
                Text="Iniciar sesión"
                HeightRequest="55"
                BackgroundColor="{StaticResource ColorPrimario}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="17"
                FontAttributes="Bold"
                CornerRadius="15"
                Clicked="OnIniciarSesionClicked">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="1" />
                                    <Setter
                                        Property="Opacity"
                                        Value="1" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="1.03" />
                                    <Setter
                                        Property="BackgroundColor"
                                        Value="{StaticResource ColorPrimarioOscuro}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="0.97" />
                                    <Setter
                                        Property="Opacity"
                                        Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <!-- CREAR CUENTA -->

            <Button
                Text="Crear una cuenta"
                BackgroundColor="Transparent"
                TextColor="{StaticResource ColorPrimario}"
                FontAttributes="Bold"
                Clicked="OnCrearCuentaClicked">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal" />

                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="1.03" />
                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource ColorPrimarioOscuro}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="0.97" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <Grid
                ColumnDefinitions="*,Auto,*"
                ColumnSpacing="12"
                Margin="0,10">

                <BoxView
                    Grid.Column="0"
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="1"
                    Text="o"
                    TextColor="{StaticResource ColorTextoDeshabilitado}" />

                <BoxView
                    Grid.Column="2"
                    HeightRequest="1"
                    BackgroundColor="{StaticResource ColorBorde}"
                    VerticalOptions="Center" />

            </Grid>

            <!-- HUELLA -->

            <Button
                Text="🔐 Ingresar con huella"
                HeightRequest="55"
                BackgroundColor="{StaticResource ColorSuperficie}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="17"
                CornerRadius="15"
                Clicked="OnHuellaClicked">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal" />

                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="1.03" />
                                    <Setter
                                        Property="BackgroundColor"
                                        Value="{StaticResource ColorSuperficieClara}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter
                                        Property="Scale"
                                        Value="0.97" />
                                    <Setter
                                        Property="Opacity"
                                        Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <!-- MENSAJE GENERAL PARA HUELLA -->

            <Label
                x:Name="MensajeLabel"
                TextColor="{StaticResource ColorError}"
                FontSize="14"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                IsVisible="False" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
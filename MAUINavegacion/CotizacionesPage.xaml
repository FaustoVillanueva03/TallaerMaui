<?xml version="1.0" encoding="utf-8" ?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    x:Class="MAUINavegacion.CotizacionesPage"
    Title="Cotizaciones"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Button
                Text="← Volver"
                HorizontalOptions="Start"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                CornerRadius="12"
                Clicked="OnVolverClicked" />

            <Label
                Text="COTIZACIONES"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{StaticResource ColorTextoPrincipal}" />

            <Label
                Text="Valores actualizados respecto al peso uruguayo"
                FontSize="16"
                TextColor="{StaticResource ColorTextoSecundario}" />

            <!-- DÓLAR -->

            <Border
                Padding="15"
                Stroke="{StaticResource ColorPrimario}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="💵 Dólar"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="DolarLabel"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorPrimario}" />

                </VerticalStackLayout>

            </Border>

            <!-- EURO -->

            <Border
                Padding="15"
                Stroke="{StaticResource ColorPrimario}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="💶 Euro"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="EuroLabel"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorPrimario}" />

                </VerticalStackLayout>

            </Border>

            <!-- REAL -->

            <Border
                Padding="15"
                Stroke="{StaticResource ColorPrimario}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="🇧🇷 Real"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="RealLabel"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorPrimario}" />

                </VerticalStackLayout>

            </Border>

            <ActivityIndicator
                x:Name="Cargando"
                IsVisible="False"
                IsRunning="False"
                Color="{StaticResource ColorPrimario}"
                HorizontalOptions="Center" />

            <BoxView
                HeightRequest="1"
                BackgroundColor="{StaticResource ColorBorde}"
                Margin="0,10" />

            <!-- CONVERSOR -->

            <Label
                Text="Conversor de monedas"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{StaticResource ColorTextoPrincipal}" />

            <Entry
                x:Name="MontoEntry"
                Placeholder="Ingresá un monto"
                Keyboard="Numeric"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}" />

            <Picker
                x:Name="MonedaPicker"
                Title="Seleccioná la moneda"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                TitleColor="{StaticResource ColorTextoDeshabilitado}" />

            <Button
                Text="Convertir"
                HeightRequest="50"
                BackgroundColor="{StaticResource ColorPrimario}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontAttributes="Bold"
                CornerRadius="12"
                Clicked="OnConvertirClicked" />

            <Border
                Padding="15"
                Margin="0,10,0,0"
                Stroke="{StaticResource ColorPrimario}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        x:Name="ResultadoUYU"
                        FontSize="18"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="ResultadoUSD"
                        FontSize="18"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="ResultadoEUR"
                        FontSize="18"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="ResultadoBRL"
                        FontSize="18"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</local:BasePage>
<?xml version="1.0" encoding="utf-8" ?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    x:Class="MAUINavegacion.CotizacionesPage"
    Title="Cotizaciones"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout
            Padding="22"
            Spacing="22"
            MaximumWidthRequest="1100"
            HorizontalOptions="Center">

            <!-- ENCABEZADO -->

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="18">

                <Button
                    Grid.Column="0"
                    Text="← Volver"
                    Padding="18,10"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource ColorSuperficie}"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    BorderColor="{StaticResource ColorPrimario}"
                    BorderWidth="1"
                    CornerRadius="12"
                    Clicked="OnVolverClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="4"
                    VerticalOptions="Center">

                    <Label
                        Text="COTIZACIONES"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        Text="Valores de las monedas respecto al peso uruguayo"
                        FontSize="15"
                        TextColor="{StaticResource ColorTextoSecundario}" />

                </VerticalStackLayout>

            </Grid>

            <!-- INFORMACIÓN DE ACTUALIZACIÓN -->

            <Border
                Padding="14,10"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*">

                    <Label
                        Grid.Column="0"
                        Text="🕒"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        x:Name="FechaActualizacionLabel"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Text="Cargando cotizaciones..."
                        FontSize="13"
                        VerticalOptions="Center"
                        TextColor="{StaticResource ColorTextoSecundario}" />

                </Grid>

            </Border>

            <!-- TARJETAS DE COTIZACIONES -->

            <FlexLayout
                Direction="Row"
                Wrap="Wrap"
                AlignItems="Stretch"
                JustifyContent="SpaceBetween">

                <!-- DÓLAR -->

                <Border
                    Margin="0,0,10,12"
                    Padding="20"
                    MinimumWidthRequest="260"
                    FlexLayout.Basis="300"
                    FlexLayout.Grow="1"
                    Stroke="{StaticResource ColorPrimario}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource ColorSuperficie}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*">

                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource ColorSuperficieClara}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <Label
                                    Text="💵"
                                    FontSize="25"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">

                                <Label
                                    Text="Dólar"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Label
                                    Text="USD"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                            </VerticalStackLayout>

                        </Grid>

                        <Label
                            x:Name="DolarLabel"
                            Text="Cargando..."
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorPrimario}" />

                    </VerticalStackLayout>

                </Border>

                <!-- EURO -->

                <Border
                    Margin="0,0,10,12"
                    Padding="20"
                    MinimumWidthRequest="260"
                    FlexLayout.Basis="300"
                    FlexLayout.Grow="1"
                    Stroke="{StaticResource ColorPrimario}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource ColorSuperficie}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*">

                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource ColorSuperficieClara}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <Label
                                    Text="💶"
                                    FontSize="25"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">

                                <Label
                                    Text="Euro"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Label
                                    Text="EUR"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                            </VerticalStackLayout>

                        </Grid>

                        <Label
                            x:Name="EuroLabel"
                            Text="Cargando..."
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorPrimario}" />

                    </VerticalStackLayout>

                </Border>

                <!-- REAL -->

                <Border
                    Margin="0,0,0,12"
                    Padding="20"
                    MinimumWidthRequest="260"
                    FlexLayout.Basis="300"
                    FlexLayout.Grow="1"
                    Stroke="{StaticResource ColorPrimario}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource ColorSuperficie}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*">

                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource ColorSuperficieClara}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <Label
                                    Text="🇧🇷"
                                    FontSize="25"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">

                                <Label
                                    Text="Real brasileño"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Label
                                    Text="BRL"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                            </VerticalStackLayout>

                        </Grid>

                        <Label
                            x:Name="RealLabel"
                            Text="Cargando..."
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorPrimario}" />

                    </VerticalStackLayout>

                </Border>

            </FlexLayout>

            <ActivityIndicator
                x:Name="Cargando"
                IsVisible="False"
                IsRunning="False"
                WidthRequest="45"
                HeightRequest="45"
                Color="{StaticResource ColorPrimario}"
                HorizontalOptions="Center" />

            <!-- CONVERSOR -->

            <Border
                Padding="22"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="17">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Conversor de monedas"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorTextoPrincipal}" />

                        <Label
                            Text="Ingresá un importe y seleccioná su moneda de origen"
                            FontSize="14"
                            TextColor="{StaticResource ColorTextoSecundario}" />

                    </VerticalStackLayout>

                    <Label
                        Text="Monto"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Border
                        Padding="14,3"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource ColorSuperficieClara}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="MontoEntry"
                            Placeholder="Ejemplo: 1000"
                            Keyboard="Numeric"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource ColorTextoPrincipal}"
                            PlaceholderColor="{StaticResource ColorTextoDeshabilitado}" />

                    </Border>

                    <Label
                        Text="Moneda de origen"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Border
    HeightRequest="58"
    Padding="12,0"
    Stroke="{StaticResource ColorBorde}"
    StrokeThickness="1"
    BackgroundColor="{StaticResource ColorSuperficieClara}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Picker
        x:Name="MonedaPicker"
        HeightRequest="56"
        Margin="0"
        VerticalOptions="Center"
        VerticalTextAlignment="Center"
        BackgroundColor="Transparent"
        TextColor="{StaticResource ColorTextoPrincipal}" />

                    </Border>

                    <Button
                        Text="Convertir"
                        HeightRequest="52"
                        Margin="0,5,0,0"
                        BackgroundColor="{StaticResource ColorPrimario}"
                        TextColor="{StaticResource ColorTextoPrincipal}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Clicked="OnConvertirClicked" />

                </VerticalStackLayout>

            </Border>

            <!-- RESULTADOS -->

            <Border
                x:Name="ResultadoBorder"
                IsVisible="False"
                Padding="22"
                Stroke="{StaticResource ColorPrimario}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Resultado de la conversión"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                    <Label
                        x:Name="MontoOriginalLabel"
                        FontSize="14"
                        TextColor="{StaticResource ColorTextoSecundario}" />

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource ColorBorde}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="12">

                        <Border
                            x:Name="ResultadoUYUBorder"
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="14"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficieClara}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Pesos uruguayos"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                                <Label
                                    x:Name="ResultadoUYU"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorPrimario}" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="ResultadoUSDBorder"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="14"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficieClara}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Dólares"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                                <Label
                                    x:Name="ResultadoUSD"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorPrimario}" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="ResultadoEURBorder"
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="14"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficieClara}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Euros"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                                <Label
                                    x:Name="ResultadoEUR"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorPrimario}" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="ResultadoBRLBorder"
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="14"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficieClara}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Reales"
                                    FontSize="12"
                                    TextColor="{StaticResource ColorTextoSecundario}" />

                                <Label
                                    x:Name="ResultadoBRL"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource ColorPrimario}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</local:BasePage>
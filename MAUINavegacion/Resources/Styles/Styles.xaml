<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- PÁGINAS -->

    <Style
        TargetType="Page"
        ApplyToDerivedTypes="True">

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorFondo}" />

        <Setter
            Property="Padding"
            Value="0" />
    </Style>


    <!-- TEXTOS -->

    <Style TargetType="Label">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="BackgroundColor"
            Value="Transparent" />

        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />

        <Setter
            Property="FontSize"
            Value="14" />

    </Style>

    <Style
        TargetType="Label"
        x:Key="Headline">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="FontSize"
            Value="32" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />

    </Style>

    <Style
        TargetType="Label"
        x:Key="SubHeadline">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="FontSize"
            Value="18" />

        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />

    </Style>


    <!-- BOTONES -->

    <Style TargetType="Button">

        <Setter
            Property="TextColor"
            Value="White" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorPrimario}" />

        <Setter
            Property="FontFamily"
            Value="OpenSansSemibold" />

        <Setter
            Property="FontSize"
            Value="16" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="CornerRadius"
            Value="12" />

        <Setter
            Property="HeightRequest"
            Value="52" />

        <Setter
            Property="Padding"
            Value="16,10" />

        <Setter
            Property="BorderWidth"
            Value="0" />

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="PointerOver">

                        <VisualState.Setters>

                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource ColorPrimarioOscuro}" />

                        </VisualState.Setters>

                    </VisualState>

                    <VisualState x:Name="Disabled">

                        <VisualState.Setters>

                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource ColorTextoDeshabilitado}" />

                            <Setter
                                Property="TextColor"
                                Value="{StaticResource ColorTextoSecundario}" />

                        </VisualState.Setters>

                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- CAMPOS DE TEXTO -->

    <Style TargetType="Entry">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="PlaceholderColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="HeightRequest"
            Value="52" />

        <Setter
            Property="Margin"
            Value="0,4" />

    </Style>

    <Style TargetType="Editor">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="PlaceholderColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="MinimumHeightRequest"
            Value="100" />

    </Style>


    <!-- BUSCADOR -->

    <Style TargetType="SearchBar">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="PlaceholderColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="CancelButtonColor"
            Value="{StaticResource ColorPrimario}" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="HeightRequest"
            Value="52" />

    </Style>


    <!-- TARJETAS Y BORDES -->

    <Style TargetType="Border">

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="Stroke"
            Value="{StaticResource ColorBorde}" />

        <Setter
            Property="StrokeThickness"
            Value="1" />

        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 14" />

        <Setter
            Property="Padding"
            Value="12" />

    </Style>

    <Style TargetType="Frame">

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="BorderColor"
            Value="{StaticResource ColorBorde}" />

        <Setter
            Property="CornerRadius"
            Value="14" />

        <Setter
            Property="Padding"
            Value="12" />

        <Setter
            Property="HasShadow"
            Value="False" />

    </Style>


    <!-- INDICADORES -->

    <Style TargetType="ActivityIndicator">

        <Setter
            Property="Color"
            Value="{StaticResource ColorPrimario}" />

    </Style>

    <Style TargetType="ProgressBar">

        <Setter
            Property="ProgressColor"
            Value="{StaticResource ColorPrimario}" />

    </Style>


    <!-- CHECKBOX Y SWITCH -->

    <Style TargetType="CheckBox">

        <Setter
            Property="Color"
            Value="{StaticResource ColorPrimario}" />

    </Style>

    <Style TargetType="Switch">

        <Setter
            Property="OnColor"
            Value="{StaticResource ColorPrimario}" />

        <Setter
            Property="ThumbColor"
            Value="White" />

    </Style>


    <!-- PICKER -->

    <Style TargetType="Picker">

        <Setter
            Property="TextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="TitleColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="HeightRequest"
            Value="52" />

    </Style>


    <!-- NAVEGACIÓN -->

    <Style TargetType="NavigationPage">

        <Setter
            Property="BarBackgroundColor"
            Value="{StaticResource ColorFondo}" />

        <Setter
            Property="BarTextColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="IconColor"
            Value="{StaticResource ColorPrimario}" />

    </Style>

    <Style
        TargetType="Shell"
        ApplyToDerivedTypes="True">

        <Setter
            Property="Shell.BackgroundColor"
            Value="{StaticResource ColorFondo}" />

        <Setter
            Property="Shell.ForegroundColor"
            Value="{StaticResource ColorPrimario}" />

        <Setter
            Property="Shell.TitleColor"
            Value="{StaticResource ColorTextoPrincipal}" />

        <Setter
            Property="Shell.UnselectedColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="Shell.TabBarBackgroundColor"
            Value="{StaticResource ColorSuperficie}" />

        <Setter
            Property="Shell.TabBarForegroundColor"
            Value="{StaticResource ColorPrimario}" />

        <Setter
            Property="Shell.TabBarTitleColor"
            Value="{StaticResource ColorPrimario}" />

        <Setter
            Property="Shell.TabBarUnselectedColor"
            Value="{StaticResource ColorTextoSecundario}" />

        <Setter
            Property="Shell.NavBarHasShadow"
            Value="False" />

    </Style>

</ResourceDictionary>
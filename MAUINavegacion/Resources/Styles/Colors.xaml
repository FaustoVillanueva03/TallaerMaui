<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colores principales -->

    <Color x:Key="ColorFondo">#0B0B0B</Color>
    <Color x:Key="ColorSuperficie">#1C1C1C</Color>
    <Color x:Key="ColorSuperficieClara">#262626</Color>

    <!-- Dorado oscuro -->

    <Color x:Key="ColorPrimario">#B08D57</Color>
    <Color x:Key="ColorPrimarioOscuro">#8A6A3E</Color>

    <!-- Textos -->

    <Color x:Key="ColorTextoPrincipal">#FFFFFF</Color>
    <Color x:Key="ColorTextoSecundario">#B3B3B3</Color>
    <Color x:Key="ColorTextoDeshabilitado">#777777</Color>

    <!-- Bordes y estados -->

    <Color x:Key="ColorBorde">#3A3329</Color>
    <Color x:Key="ColorError">#FF8A8A</Color>
    <Color x:Key="ColorExito">#4CAF50</Color>

    <!-- Colores anteriores para no romper otras páginas -->

    <Color x:Key="Primary">#B08D57</Color>
    <Color x:Key="PrimaryDark">#8A6A3E</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <Color x:Key="Secondary">#B3B3B3</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#0B0B0B</Color>

    <Color x:Key="Magenta">#B08D57</Color>
    <Color x:Key="MidnightBlue">#0B0B0B</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

</ResourceDictionary>
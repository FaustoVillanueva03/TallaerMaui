<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAUINavegacion.MainPage"
    Title="Inicio"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- CABECERA -->

            <Grid
                Padding="28,35,28,30"
                RowDefinitions="Auto,Auto,Auto"
                BackgroundColor="{StaticResource ColorSuperficie}">

                <Label
                    Grid.Row="0"
                    Text="REDFLIX"
                    TextColor="{StaticResource ColorPrimario}"
                    FontSize="17"
                    FontAttributes="Bold"
                    CharacterSpacing="5" />

                <Label
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Text="Todo tu entretenimiento"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    FontSize="32"
                    FontAttributes="Bold" />

                <Label
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Text="Películas, series, clima y mucho más"
                    TextColor="{StaticResource ColorTextoSecundario}"
                    FontSize="15" />

            </Grid>

            <!-- CONTENIDO -->

            <VerticalStackLayout
                Padding="22"
                Spacing="18">

                <Label
                    Text="Explorar"
                    TextColor="{StaticResource ColorTextoPrincipal}"
                    FontSize="24"
                    FontAttributes="Bold" />

                <!-- CINE -->

                <Border
                    BackgroundColor="{StaticResource ColorSuperficie}"
                    Stroke="{StaticResource ColorBorde}"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCineClicked" />
                    </Border.GestureRecognizers>

                    <Grid
                        HeightRequest="145"
                        ColumnDefinitions="125,*">

                        <Grid
                            Grid.Column="0"
                            BackgroundColor="{StaticResource ColorPrimarioOscuro}">

                            <Label
                                Text="🎬"
                                FontSize="58"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Grid>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Padding="20"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Películas"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                FontSize="25"
                                FontAttributes="Bold" />

                            <Label
                                Text="Películas, estrenos y tráilers"
                                TextColor="{StaticResource ColorTextoSecundario}"
                                FontSize="14"
                                MaxLines="2" />

                            <Label
                                Text="Explorar  →"
                                TextColor="{StaticResource ColorPrimario}"
                                FontSize="14"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- SERIES -->

                <Border
                    BackgroundColor="{StaticResource ColorSuperficie}"
                    Stroke="{StaticResource ColorBorde}"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSeriesClicked" />
                    </Border.GestureRecognizers>

                    <Grid
                        HeightRequest="145"
                        ColumnDefinitions="125,*">

                        <Grid
                            Grid.Column="0"
                            BackgroundColor="{StaticResource ColorPrimarioOscuro}">

                            <Label
                                Text="📺"
                                FontSize="58"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Grid>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Padding="20"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Series"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                FontSize="25"
                                FontAttributes="Bold" />

                            <Label
                                Text="Series populares y mejor puntuadas"
                                TextColor="{StaticResource ColorTextoSecundario}"
                                FontSize="14"
                                MaxLines="2" />

                            <Label
                                Text="Explorar  →"
                                TextColor="{StaticResource ColorPrimario}"
                                FontSize="14"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- CLIMA Y COTIZACIONES -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="14">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{StaticResource ColorSuperficie}"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClimaClicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="🌤️"
                                FontSize="42" />

                            <Label
                                Text="Clima"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                FontSize="21"
                                FontAttributes="Bold" />

                            <Label
                                Text="Pronóstico de Punta del Este"
                                TextColor="{StaticResource ColorTextoSecundario}"
                                FontSize="13"
                                MaxLines="2" />

                            <Label
                                Text="Ver más  →"
                                TextColor="{StaticResource ColorPrimario}"
                                FontSize="13"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{StaticResource ColorSuperficie}"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCotizacionesClicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="💵"
                                FontSize="42" />

                            <Label
                                Text="Cotizaciones"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                FontSize="21"
                                FontAttributes="Bold" />

                            <Label
                                Text="Dólar, euro y real"
                                TextColor="{StaticResource ColorTextoSecundario}"
                                FontSize="13"
                                MaxLines="2" />

                            <Label
                                Text="Ver más  →"
                                TextColor="{StaticResource ColorPrimario}"
                                FontSize="13"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- MAPA Y PERFIL -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="14">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{StaticResource ColorSuperficie}"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMapaClicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="📍"
                                FontSize="42" />

                            <Label
                                Text="Mapa"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                FontSize="21"
                                FontAttributes="Bold" />

                            <Label
                                Text="Ubicaciones guardadas"
                                TextColor="{StaticResource ColorTextoSecundario}"
                                FontSize="13"
                                MaxLines="2" />

                            <Label
                                Text="Ver más  →"
                                TextColor="{StaticResource ColorPrimario}"
                                FontSize="13"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{StaticResource ColorSuperficie}"
                        Stroke="{StaticResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPerfilClicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="👤"
                                FontSize="42" />

                            <Label
                                Text="Perfil"
                                TextColor="{StaticResource ColorTextoPrincipal}"
                                FontSize="21"
                                FontAttributes="Bold" />

                            <Label
                                Text="Datos y preferencias"
                                TextColor="{StaticResource ColorTextoSecundario}"
                                FontSize="13"
                                MaxLines="2" />

                            <Label
                                Text="Ver más  →"
                                TextColor="{StaticResource ColorPrimario}"
                                FontSize="13"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
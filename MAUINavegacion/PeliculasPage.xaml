<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MAUINavegacion.Models"
    x:Class="MAUINavegacion.PeliculasPage"
    Title="Películas"
    BackgroundColor="{StaticResource ColorFondo}">

    <ContentPage.Resources>

        <Style
            x:Key="TarjetaContenidoStyle"
            TargetType="Border">

            <Setter
                Property="BackgroundColor"
                Value="{StaticResource ColorSuperficie}" />

            <Setter
                Property="Stroke"
                Value="{StaticResource ColorBorde}" />

            <Setter
                Property="StrokeThickness"
                Value="1" />

            <Setter
                Property="Scale"
                Value="1" />

            <Setter
                Property="Opacity"
                Value="1" />

            <Setter Property="VisualStateManager.VisualStateGroups">

                <VisualStateGroupList>

                    <VisualStateGroup x:Name="CommonStates">

                        <VisualState x:Name="Normal">

                            <VisualState.Setters>

                                <Setter
                                    Property="Scale"
                                    Value="1" />

                                <Setter
                                    Property="Opacity"
                                    Value="1" />

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource ColorSuperficie}" />

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource ColorBorde}" />

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState x:Name="PointerOver">

                            <VisualState.Setters>

                                <Setter
                                    Property="Scale"
                                    Value="1" />

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource ColorSuperficieClara}" />

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource ColorPrimario}" />

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState x:Name="Pressed">

                            <VisualState.Setters>

                                <Setter
                                    Property="Scale"
                                    Value="0.98" />

                                <Setter
                                    Property="Opacity"
                                    Value="0.85" />

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource ColorPrimario}" />

                            </VisualState.Setters>

                        </VisualState>

                    </VisualStateGroup>

                </VisualStateGroupList>

            </Setter>

        </Style>

    </ContentPage.Resources>

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Text="⚙"
            Order="Primary"
            Priority="0"
            Clicked="OnPreferenciasClicked" />

    </ContentPage.ToolbarItems>

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <!-- BOTÓN VOLVER -->

        <Button
            Grid.Row="0"
            Text="← Volver"
            HorizontalOptions="Start"
            BackgroundColor="{StaticResource ColorSuperficie}"
            TextColor="{StaticResource ColorTextoPrincipal}"
            BorderColor="{StaticResource ColorPrimario}"
            BorderWidth="1"
            CornerRadius="12"
            Clicked="OnVolverClicked" />

        <!-- ENCABEZADO -->

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="3">

            <Label
                Text="MOVIE APP"
                TextColor="{StaticResource ColorPrimario}"
                FontSize="14"
                FontAttributes="Bold"
                CharacterSpacing="3" />

            <Label
                Text="Películas populares"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                Text="Seleccioná una película para ver sus detalles"
                TextColor="{StaticResource ColorTextoSecundario}"
                FontSize="14" />

        </VerticalStackLayout>

        <!-- INDICADOR DE CARGA -->

        <ActivityIndicator
            x:Name="Cargando"
            Grid.Row="2"
            IsVisible="False"
            IsRunning="False"
            Color="{StaticResource ColorPrimario}"
            WidthRequest="50"
            HeightRequest="50"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- LISTA DE PELÍCULAS -->

        <CollectionView
            x:Name="ListaPeliculas"
            Grid.Row="2"
            SelectionMode="Single"
            SelectionChanged="OnPeliculaSeleccionada"
            EmptyView="No se encontraron películas">

            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="14" />

            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Pelicula">

                    <Border
                        Style="{StaticResource TarjetaContenidoStyle}"
                        Padding="12"
                        Margin="8,4">
                        
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="110,*"
                            ColumnSpacing="16">

                            <!-- IMAGEN -->

                            <Border
                                Grid.Column="0"
                                WidthRequest="110"
                                HeightRequest="165"
                                StrokeThickness="0"
                                Padding="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Image
                                    Source="{Binding ImagenCompleta}"
                                    Aspect="AspectFill" />

                            </Border>

                            <!-- INFORMACIÓN -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="10">

                                <Label
                                    Text="{Binding Titulo}"
                                    TextColor="{StaticResource ColorTextoPrincipal}"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />

                                <HorizontalStackLayout Spacing="8">

                                    <!-- PUNTUACIÓN -->

                                    <Border
                                        BackgroundColor="{StaticResource ColorPrimarioOscuro}"
                                        StrokeThickness="0"
                                        Padding="10,5">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding PuntuacionTexto}"
                                            TextColor="{StaticResource ColorTextoPrincipal}"
                                            FontAttributes="Bold"
                                            FontSize="13" />

                                    </Border>

                                    <!-- FECHA -->

                                    <Border
                                        BackgroundColor="{StaticResource ColorSuperficieClara}"
                                        StrokeThickness="0"
                                        Padding="10,5">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding FechaTexto}"
                                            TextColor="{StaticResource ColorTextoSecundario}"
                                            FontSize="13" />

                                    </Border>

                                </HorizontalStackLayout>

                                <Label
                                    Text="{Binding DescripcionCompleta}"
                                    TextColor="{StaticResource ColorTextoSecundario}"
                                    FontSize="14"
                                    MaxLines="3"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="Ver detalles  →"
                                    TextColor="{StaticResource ColorPrimario}"
                                    FontSize="14"
                                    FontAttributes="Bold" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
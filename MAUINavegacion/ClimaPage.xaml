<?xml version="1.0" encoding="utf-8" ?>

<local:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUINavegacion"
    x:Class="MAUINavegacion.ClimaPage"
    Title="Clima"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="22"
            HorizontalOptions="Fill">

            <!-- VOLVER -->

            <Button
                Text="← Volver"
                HorizontalOptions="Start"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                CornerRadius="12"
                Clicked="OnVolverClicked" />

            <!-- TÍTULO -->

            <Label
                Text="CLIMA"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoPrincipal}" />

            <Label
                x:Name="CiudadLabel"
                FontSize="18"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoSecundario}" />

            <!-- CLIMA ACTUAL -->

            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Center"
                Margin="0,10,0,15">

                <Image
                    x:Name="IconoImage"
                    WidthRequest="120"
                    HeightRequest="120"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="TemperaturaLabel"
                    FontSize="50"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorPrimario}" />

                <Label
                    x:Name="DescripcionLabel"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorTextoPrincipal}" />

                <Label
                    x:Name="SensacionLabel"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorTextoSecundario}" />

                <Label
                    x:Name="HumedadLabel"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource ColorTextoSecundario}" />

            </VerticalStackLayout>

            <ActivityIndicator
                x:Name="Cargando"
                IsRunning="False"
                IsVisible="False"
                Color="{StaticResource ColorPrimario}"
                HorizontalOptions="Center" />

            <!-- PRONÓSTICO -->

            <Label
                Text="Pronóstico de los próximos 5 días"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoPrincipal}"
                Margin="0,15,0,0" />

            <Label
                Text="Deslizá hacia los costados para ver todos los días →"
                FontSize="13"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoSecundario}"
                Margin="0,-8,0,0" />

            <CollectionView
    x:Name="ListaPronostico"
    HeightRequest="270"
    SelectionMode="None"
    HorizontalOptions="Center"
    HorizontalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
            Orientation="Horizontal"
            ItemSpacing="14" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                Margin="2"
                Padding="16"
                Stroke="{StaticResource ColorBorde}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource ColorSuperficie}">

                            <Border.WidthRequest>
                                <OnIdiom
                        x:TypeArguments="x:Double"
                        Phone="155"
                        Tablet="190"
                        Desktop="300" />
                            </Border.WidthRequest>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                    Spacing="9"
                    VerticalOptions="Center">

                                <Label
                        Text="{Binding Dia}"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource ColorTextoPrincipal}" />

                                <Image
                        Source="{Binding IconoCompleto}"
                        WidthRequest="68"
                        HeightRequest="68"
                        HorizontalOptions="Center" />

                                <Label
                        Text="{Binding TemperaturaTexto}"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource ColorPrimario}" />

                                <Label
                        Text="{Binding Descripcion}"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        MaxLines="2"
                        LineBreakMode="TailTruncation"
                        TextColor="{StaticResource ColorTextoSecundario}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- RECOMENDACIÓN -->

            <Label
                Text="Recomendado para este clima"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoPrincipal}"
                Margin="0,15,0,0" />

            <Label
                x:Name="MotivoRecomendacionLabel"
                FontSize="16"
                HorizontalOptions="Fill"
                LineBreakMode="WordWrap"
                TextColor="{StaticResource ColorTextoSecundario}" />

            <!-- PELÍCULAS -->

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10"
                Margin="0,15,0,0"
                HorizontalOptions="Fill">

                <Label
                    Grid.Column="0"
                    Text="Películas recomendadas según el clima"
                    FontSize="20"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource ColorTextoPrincipal}" />

                <Button
                    Grid.Column="1"
                    Text="Ver todas →"
                    Padding="12,8"
                    CornerRadius="12"
                    BackgroundColor="{StaticResource ColorSuperficie}"
                    TextColor="{StaticResource ColorPrimario}"
                    BorderColor="{StaticResource ColorPrimario}"
                    BorderWidth="1"
                    Clicked="OnVerPeliculasClicked" />

            </Grid>

            <Label
                Text="Deslizá para ver más →"
                FontSize="13"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoSecundario}" />

            <CollectionView
                x:Name="ListaPeliculasClima"
                HeightRequest="330"
                HorizontalOptions="Fill"
                SelectionMode="Single"
                SelectionChanged="OnPeliculaSeleccionada"
                HorizontalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Horizontal"
                        ItemSpacing="12" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="8"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficie}">

                            <Border.WidthRequest>
                                <OnIdiom
                                    x:TypeArguments="x:Double"
                                    Phone="165"
                                    Tablet="180"
                                    Desktop="190" />
                            </Border.WidthRequest>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Image
                                    Source="{Binding ImagenCompleta}"
                                    HeightRequest="225"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill" />

                                <Label
                                    Text="{Binding Titulo}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- SERIES -->

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10"
                Margin="0,15,0,0"
                HorizontalOptions="Fill">

                <Label
                    Grid.Column="0"
                    Text="Series recomendadas según el clima"
                    FontSize="20"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource ColorTextoPrincipal}" />

                <Button
                    Grid.Column="1"
                    Text="Ver todas →"
                    Padding="12,8"
                    CornerRadius="12"
                    BackgroundColor="{StaticResource ColorSuperficie}"
                    TextColor="{StaticResource ColorPrimario}"
                    BorderColor="{StaticResource ColorPrimario}"
                    BorderWidth="1"
                    Clicked="OnVerSeriesClicked" />

            </Grid>

            <Label
                Text="Deslizá para ver más →"
                FontSize="13"
                HorizontalOptions="Start"
                TextColor="{StaticResource ColorTextoSecundario}" />

            <CollectionView
                x:Name="ListaSeriesClima"
                HeightRequest="330"
                HorizontalOptions="Fill"
                SelectionMode="Single"
                SelectionChanged="OnSerieSeleccionada"
                HorizontalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Horizontal"
                        ItemSpacing="12" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="8"
                            Stroke="{StaticResource ColorBorde}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ColorSuperficie}">

                            <Border.WidthRequest>
                                <OnIdiom
                                    x:TypeArguments="x:Double"
                                    Phone="165"
                                    Tablet="180"
                                    Desktop="190" />
                            </Border.WidthRequest>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Image
                                    Source="{Binding ImagenCompleta}"
                                    HeightRequest="225"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill" />

                                <Label
                                    Text="{Binding Nombre}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{StaticResource ColorTextoPrincipal}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</local:BasePage>
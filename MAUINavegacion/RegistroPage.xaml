<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAUINavegacion.RegistroPage"
    Title="Registro"
    BackgroundColor="{StaticResource ColorFondo}">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="16">

            <Label
                Text="Crear cuenta"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                Text="Completá tus datos para registrarte"
                TextColor="{StaticResource ColorTextoSecundario}"
                FontSize="15"
                Margin="0,0,0,10" />

            <Entry
                x:Name="UsuarioEntry"
                Placeholder="Usuario"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BackgroundColor="{StaticResource ColorSuperficie}" />

            <Entry
                x:Name="ContrasenaEntry"
                Placeholder="Contraseña"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BackgroundColor="{StaticResource ColorSuperficie}"
                IsPassword="True" />

            <Entry
                x:Name="NombreCompletoEntry"
                Placeholder="Nombre completo"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BackgroundColor="{StaticResource ColorSuperficie}" />

            <Entry
                x:Name="DireccionEntry"
                Placeholder="Dirección"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BackgroundColor="{StaticResource ColorSuperficie}" />

            <Entry
                x:Name="TelefonoEntry"
                Placeholder="Teléfono"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BackgroundColor="{StaticResource ColorSuperficie}"
                Keyboard="Telephone" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                PlaceholderColor="{StaticResource ColorTextoDeshabilitado}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BackgroundColor="{StaticResource ColorSuperficie}"
                Keyboard="Email" />

            <Button
                Text="Seleccionar foto"
                BackgroundColor="{StaticResource ColorSuperficie}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                BorderColor="{StaticResource ColorPrimario}"
                BorderWidth="1"
                CornerRadius="12"
                Clicked="OnSeleccionarFotoClicked" />

            <Image
                x:Name="FotoPerfilImage"
                HeightRequest="160"
                WidthRequest="160"
                Aspect="AspectFill"
                HorizontalOptions="Center"
                IsVisible="False" />

            <Button
                Text="Registrarme"
                HeightRequest="55"
                BackgroundColor="{StaticResource ColorPrimario}"
                TextColor="{StaticResource ColorTextoPrincipal}"
                FontAttributes="Bold"
                CornerRadius="12"
                Clicked="OnRegistrarClicked" />

            <Label
                x:Name="MensajeLabel"
                TextColor="{StaticResource ColorError}"
                FontSize="14"
                HorizontalTextAlignment="Center"
                IsVisible="False" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>